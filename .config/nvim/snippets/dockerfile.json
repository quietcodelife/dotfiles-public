{
  "Dockerfile Node app": {
    "prefix": "dnode",
    "description": "Multi-stage Dockerfile for a Node.js app",
    "body": [
      "FROM node:${1:22}-alpine AS deps",
      "WORKDIR /app",
      "COPY package*.json ./",
      "RUN npm ci",
      "",
      "FROM node:${1:22}-alpine AS build",
      "WORKDIR /app",
      "COPY --from=deps /app/node_modules ./node_modules",
      "COPY . .",
      "RUN npm run build",
      "",
      "FROM node:${1:22}-alpine AS runner",
      "WORKDIR /app",
      "ENV NODE_ENV=production",
      "COPY --from=build /app/${2:dist} ./${2:dist}",
      "COPY package*.json ./",
      "RUN npm ci --omit=dev && npm cache clean --force",
      "EXPOSE ${3:3000}",
      "CMD [\"npm\", \"run\", \"${4:start}\"]"
    ]
  },
  "Dockerfile Python app": {
    "prefix": "dpy",
    "description": "Dockerfile for a Python app",
    "body": [
      "FROM python:${1:3.12}-slim",
      "",
      "ENV PYTHONDONTWRITEBYTECODE=1",
      "ENV PYTHONUNBUFFERED=1",
      "",
      "WORKDIR /app",
      "COPY requirements*.txt ./",
      "RUN pip install --no-cache-dir -r ${2:requirements.txt}",
      "COPY . .",
      "",
      "EXPOSE ${3:8000}",
      "CMD [\"${4:python}\", \"${5:app.py}\"]"
    ]
  }
}
